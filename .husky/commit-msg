

echo "📝 Checking commit message with the conventions of the @commitlint/config-conventional ..."

npx commitlint --edit "$1"

status=$?

if [ $status -ne 0 ]; then
  echo "❌ Commit message is invalid! Use format: <type>(scope): message"
  echo "🔗 Example: feat(auth): add login feature"
  exit 1
else
  echo "✅ excellent , Commit message is valid!"
fi