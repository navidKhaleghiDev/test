#!/bin/sh

REMOTE_NAME="$1"
TARGET_BRANCH="develop"
CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)

# Block pushing directly to develop
if [ "$CURRENT_BRANCH" = "$TARGET_BRANCH" ]; then
  echo "🚫 Pushing directly to '$TARGET_BRANCH' is not allowed!"
  exit 1
fi

# Fetch latest changes from target branch on remote being pushed to
echo "🔄 Fetching latest '$TARGET_BRANCH' from '$REMOTE_NAME'..."
git pull "$REMOTE_NAME" "$TARGET_BRANCH"

# Check if merge failed
if [ $? -ne 0 ]; then
  echo "❌ Merge failed. Resolve conflicts before pushing."
  exit 1
fi

echo "✅ Pull successful. Proceeding with push..."

echo "🚀 Running Pre-push Checks..."
echo "📦 Checking build..."

npm run build --if-present
BUILD_EXIT_CODE=$?

if [ $BUILD_EXIT_CODE -ne 0 ]; then
  echo "❌ Build failed! Push aborted."
  exit 1
fi

echo "✅ Pre-push checks passed. Proceeding with push..."
