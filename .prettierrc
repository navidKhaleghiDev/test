{
  "bracketSpacing": true,
  "endOfLine": "auto",
  "singleQuote": true,
  "tabWidth": 2,
  "arrowParens": "avoid",
  "htmlWhitespaceSensitivity": "css",
  "insertPragma": false,
  "bracketSameLine": false,
  "jsxSingleQuote": false,
  "proseWrap": "always",
  "quoteProps": "as-needed",
  "requirePragma": false,
  "useTabs": false,
  "plugins": ["prettier-plugin-tailwindcss"],
  "semi": false,
  "printWidth": 100,
  "trailingComma": "es5"
}
